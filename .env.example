# ─────────────────────────────────────────────────────────────
#  SMSService — environment configuration
#  Copy to `.env` and fill in your values.  NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──────────────────────────────────────
# With Docker Compose these compose DATABASE_URL automatically.
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# For LOCAL (non-Docker) backend dev, set these directly instead:
# DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name
# REDIS_URL=redis://localhost:6379

# Backend HTTP port (defaults to 3001 if unset; docs assume 3000 for local dev)
# PORT=3000

# ── Auth ───────────────────────────────────────────────────────
# JWT_SECRET: a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Dashboard login. CHANGE THESE — do not ship defaults to production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# Encryption key for data at rest (32-byte hex). REQUIRED in production.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_generated_32_byte_hex_key

# ── Outreach.pk SMS API (bulk SMS sending) ─────────────────────
# Optional. Enables sending bulk SMS through the outreach.pk gateway
# (sendVia="API"), as an alternative to using connected Android devices.
# Sign up and get credentials at https://outreach.pk
OUTREACH_API_ID=your_outreach_id
OUTREACH_API_PASS=your_outreach_password
# Sender mask / sender ID approved on your Outreach account
OUTREACH_MASK=Outreach

# ── Google OAuth (optional — Google Sheets recipient import) ───
# Create at: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Leopards Courier API (optional — order import) ─────────────
# LEOPARDS_KEY=your_leopards_key
# LEOPARDS_KEY_PASSWORD=your_leopards_password
# LEOPARDS_KEY_2=your_second_leopards_key
# LEOPARDS_KEY_PASSWORD_2=your_second_leopards_password

# ── URLs ───────────────────────────────────────────────────────
# Used for OAuth callbacks and redirects. Adjust for production.
API_BASE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Dashboard -> backend API base. Defaults to "/api" (works behind Nginx).
# For local dev pointing straight at the backend, set:
# NEXT_PUBLIC_API_URL=http://localhost:3000
